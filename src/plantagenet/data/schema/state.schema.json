{
  "$defs": {
    "CalendarState": {
      "additionalProperties": false,
      "properties": {
        "levy_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Levy Box"
        },
        "end_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Box"
        },
        "first_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Box"
        },
        "last_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Box"
        }
      },
      "title": "CalendarState",
      "type": "object"
    },
    "CampaignState": {
      "additionalProperties": false,
      "description": "Per-Campaign flow state (4.1-4.2): Plan stacks and Activation pointers.",
      "properties": {
        "step": {
          "default": "plan",
          "title": "Step",
          "type": "string"
        },
        "cards_required": {
          "default": 0,
          "title": "Cards Required",
          "type": "integer"
        },
        "plans": {
          "additionalProperties": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "title": "Plans",
          "type": "object"
        },
        "plan_built": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Plan Built",
          "type": "object"
        },
        "plan_index": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Plan Index",
          "type": "object"
        },
        "active_lord": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Lord"
        },
        "actions_remaining": {
          "default": 0,
          "title": "Actions Remaining",
          "type": "integer"
        }
      },
      "title": "CampaignState",
      "type": "object"
    },
    "Favour": {
      "enum": [
        "lancastrian",
        "yorkist",
        "neutral"
      ],
      "title": "Favour",
      "type": "string"
    },
    "InfluenceState": {
      "additionalProperties": false,
      "description": "Mirrors the scenario's Influence-track setup verbatim.\n\nThe Influence/scoring *mechanics* are not interpreted in Phase 1; the\nvalues are stored as given so the display is faithful and later phases\ncan build the scoring logic on top.",
      "properties": {
        "marker_at": {
          "title": "Marker At",
          "type": "integer"
        },
        "marker_side": {
          "$ref": "#/$defs/Side"
        },
        "stronghold_markers": {
          "additionalProperties": {
            "$ref": "#/$defs/StrongholdMarker"
          },
          "title": "Stronghold Markers",
          "type": "object"
        },
        "victory_check": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Victory Check"
        }
      },
      "required": [
        "marker_at",
        "marker_side"
      ],
      "title": "InfluenceState",
      "type": "object"
    },
    "LocaleState": {
      "additionalProperties": false,
      "properties": {
        "favour": {
          "$ref": "#/$defs/Favour",
          "default": "neutral"
        },
        "depletion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depletion"
        }
      },
      "title": "LocaleState",
      "type": "object"
    },
    "LordState": {
      "additionalProperties": false,
      "properties": {
        "lord_id": {
          "title": "Lord Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "status": {
          "$ref": "#/$defs/LordStatus"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "exile_box": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exile Box"
        },
        "calendar_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar Box"
        },
        "calendar_exile": {
          "default": false,
          "title": "Calendar Exile",
          "type": "boolean"
        },
        "ring": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ring"
        },
        "forces": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Forces",
          "type": "object"
        },
        "assets": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Assets",
          "type": "object"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "vassals": {
          "items": {
            "type": "string"
          },
          "title": "Vassals",
          "type": "array"
        },
        "special_vassals": {
          "items": {
            "type": "string"
          },
          "title": "Special Vassals",
          "type": "array"
        },
        "lordship_spent": {
          "default": 0,
          "title": "Lordship Spent",
          "type": "integer"
        },
        "mustered_this_segment": {
          "default": false,
          "title": "Mustered This Segment",
          "type": "boolean"
        },
        "moved_fought": {
          "default": false,
          "title": "Moved Fought",
          "type": "boolean"
        }
      },
      "required": [
        "lord_id",
        "side",
        "status"
      ],
      "title": "LordState",
      "type": "object"
    },
    "LordStatus": {
      "enum": [
        "mustered",
        "calendar",
        "exile",
        "available",
        "removed"
      ],
      "title": "LordStatus",
      "type": "string"
    },
    "Role": {
      "enum": [
        "king",
        "rebel"
      ],
      "title": "Role",
      "type": "string"
    },
    "Side": {
      "enum": [
        "lancastrian",
        "yorkist"
      ],
      "title": "Side",
      "type": "string"
    },
    "StrongholdMarker": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "$ref": "#/$defs/Side"
        },
        "at": {
          "title": "At",
          "type": "integer"
        }
      },
      "required": [
        "side",
        "at"
      ],
      "title": "StrongholdMarker",
      "type": "object"
    },
    "VassalState": {
      "additionalProperties": false,
      "properties": {
        "vassal_id": {
          "title": "Vassal Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VassalStatus"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "on_lord": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Lord"
        },
        "service_box": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Box"
        }
      },
      "required": [
        "vassal_id",
        "status"
      ],
      "title": "VassalState",
      "type": "object"
    },
    "VassalStatus": {
      "enum": [
        "at_seat",
        "mustered",
        "disbanded",
        "off_map",
        "removed"
      ],
      "title": "VassalStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 0,
      "title": "Schema Version",
      "type": "integer"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "rng_state": {
      "anyOf": [
        {
          "items": {},
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rng State"
    },
    "active_side": {
      "$ref": "#/$defs/Side"
    },
    "turn_box": {
      "title": "Turn Box",
      "type": "integer"
    },
    "phase": {
      "default": "levy",
      "title": "Phase",
      "type": "string"
    },
    "levy_step": {
      "default": "muster",
      "title": "Levy Step",
      "type": "string"
    },
    "grand_scenario": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grand Scenario"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/Role"
      },
      "title": "Roles",
      "type": "object"
    },
    "lords": {
      "additionalProperties": {
        "$ref": "#/$defs/LordState"
      },
      "title": "Lords",
      "type": "object"
    },
    "vassals": {
      "additionalProperties": {
        "$ref": "#/$defs/VassalState"
      },
      "title": "Vassals",
      "type": "object"
    },
    "locales": {
      "additionalProperties": {
        "$ref": "#/$defs/LocaleState"
      },
      "title": "Locales",
      "type": "object"
    },
    "exile_alignment": {
      "additionalProperties": {
        "$ref": "#/$defs/Side"
      },
      "title": "Exile Alignment",
      "type": "object"
    },
    "influence": {
      "additionalProperties": {
        "$ref": "#/$defs/InfluenceState"
      },
      "title": "Influence",
      "type": "object"
    },
    "calendar": {
      "$ref": "#/$defs/CalendarState"
    },
    "campaign": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "victory": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Victory"
    },
    "decks": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": "object"
      },
      "title": "Decks",
      "type": "object"
    },
    "active_events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Active Events",
      "type": "array"
    },
    "arts_of_war": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Arts Of War",
      "type": "object"
    },
    "history": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "History",
      "type": "array"
    },
    "pending": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Pending",
      "type": "array"
    }
  },
  "required": [
    "scenario",
    "seed",
    "active_side",
    "turn_box"
  ],
  "title": "Plantagenet game state",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plantagenet-harness/state.schema.json"
}
